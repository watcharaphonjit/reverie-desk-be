// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Widget {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum WarehouseType {
  CENTRAL_HUB
  BRANCH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleCode {
  ADMIN
  TELESALES
  CS
  DOCTOR
  EMPLOYEE
  BRANCH_MANAGER
  SUPER_BRANCH_MANAGER
  CENTRAL_STOCK_HUB
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  QR
  E_WALLET
}

enum PaymentType {
  DEPOSIT
  FULL
  INSTALLMENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  VOIDED
  REFUNDED
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServiceEventStatus {
  IN_PROGRESS
  COMPLETED
  VOIDED
}

enum CommissionStatus {
  PENDING
  ELIGIBLE
  LOCKED
  PAID
  REVOKED
}

enum CommissionType {
  LEAD_REWARD
  SALES_COMMISSION
}

enum CommissionValueType {
  FIXED
  PERCENTAGE
}
 
/// Commission grouping for tiered rules. Every Service must declare which
/// group it belongs to (`Service.commissionGroupCode`); a CommissionRule
/// targets a (branch, group) pair with a list of tier rows. The set of
/// supported groups is fixed by ops and bumping it is a schema change.
enum ServiceGroupCode {
  RATE_SKIN
  RATE_HAIR
  RATE_SURGERY
  RATE_TRANSPLANT
  RATE_MEDICINE
  RATE_SCULPTRA
}

enum RefundType {
  FULL_REFUND
  PARTIAL_REFUND
  CANCELLATION
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum WalletType {
  DEPOSIT
  VOUCHER
  REWARD
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  EXPIRE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum WalletReferenceType {
  SALES_ORDER
  PAYMENT
  REFUND
  BRANCH_STOCK_SALE
  MANUAL
}

enum StockItemType {
  RETAIL
  CLINICAL
}

enum ConsumptionStrategy {
  WHOLE_ONLY
  PARTIAL_ALLOWED
  PARTIAL_REQUIRED
}

enum StockLotStatus {
  ACTIVE
  QUARANTINED
  EXHAUSTED
  EXPIRED
  DISCARDED
}

enum StockMovementType {
  PURCHASE_IN
  TRANSFER_OUT
  TRANSFER_IN
  CLINICAL_USAGE
  RETAIL_SALE
  ADJUSTMENT
  RETURN
  EXPIRE
  DISCARD
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum OpenedContainerStatus {
  ACTIVE
  EMPTY
  EXPIRED
  DISCARDED
}

enum SalesChannelCode {
  WALK_IN
  DELIVERY
  STAFF
  EXECUTIVE
  VIP
  PRESENTER
}

enum BranchStockSaleStatus {
  DRAFT
  PAID
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  TRANSFER
  COMPLETE
  APPROVE
  REJECT
  PAY
  REFUND
  REVOKE
  LOGIN
  LOGOUT
}

enum NotificationType {
  APPOINTMENT_REMINDER
  PAYMENT_REMINDER
  DEPOSIT_PENDING
  LOW_STOCK
  EXPIRING_STOCK
  STOCK_TRANSFER
  REFUND_REQUEST
  REFUND_APPROVED
  COMMISSION_ELIGIBLE
  COMMISSION_PAID
  WALLET_EXPIRY
  LEAD_FOLLOWUP
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Branch {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]                 @relation("UserBranch")
  userRoles          UserRole[]             @relation("UserRoleBranch")
  customersCurrent   Customer[]             @relation("CustomerCurrentBranch")
  leads              Lead[]                 @relation("LeadBranch")
  salesOrders        SalesOrder[]           @relation("SalesOrderBranch")
  appointments       Appointment[]          @relation("AppointmentBranch")
  serviceEvents      CustomerServiceEvent[] @relation("ServiceEventBranch")
  warehouses         Warehouse[]            @relation("WarehouseBranch")
  stockTransfersOut  StockTransfer[]        @relation("StockTransferFromBranch")
  stockTransfersIn   StockTransfer[]        @relation("StockTransferToBranch")
  branchStockSales   BranchStockSale[]      @relation("BranchStockSaleBranch")
  walletTransactions WalletTransaction[]    @relation("WalletTxnBranch")
  commissionRules    CommissionRule[]       @relation("CommissionRuleBranch")
  auditLogs          AuditLog[]             @relation("AuditLogBranch")
  purchaseReceipts   PurchaseReceipt[]      @relation("PurchaseReceiptBranch")
  notifications      Notification[]         @relation("NotificationBranch")
  quarterTargets     BranchQuarterTarget[]  @relation("BranchQuarterTargetBranch")

  @@map("branches")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?    @unique
  fullName     String
  passwordHash String
  branchId     String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  branch                         Branch?                 @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  userRoles                      UserRole[]              @relation("UserRoleUser")
  leadsCreated                   Lead[]                  @relation("LeadCreatedBy")
  leadsOwned                     Lead[]                  @relation("LeadCurrentOwner")
  leadOwnerAssignmentsTo         LeadOwnerLog[]          @relation("LeadOwnerAssignedTo")
  leadOwnerAssignmentsBy         LeadOwnerLog[]          @relation("LeadOwnerAssignedBy")
  salesOrdersCreated             SalesOrder[]            @relation("SalesOrderCreatedBy")
  paymentsCreated                Payment[]               @relation("PaymentCreatedBy")
  appointmentsAsDoctor           Appointment[]           @relation("AppointmentDoctor")
  appointmentsCreated            Appointment[]           @relation("AppointmentCreatedBy")
  serviceEventsAsDoctor          CustomerServiceEvent[]  @relation("ServiceEventDoctor")
  serviceEventsAsEmployee        CustomerServiceEvent[]  @relation("ServiceEventEmployee")
  openedContainers               OpenedContainer[]       @relation("OpenedContainerOpenedBy")
  stockMovementsCreated          StockMovement[]         @relation("StockMovementCreatedBy")
  stockTransfersRequested        StockTransfer[]         @relation("StockTransferRequestedBy")
  branchStockSalesCreated        BranchStockSale[]       @relation("BranchStockSaleCreatedBy")
  branchStockRefundsApproved     BranchStockSaleRefund[] @relation("BranchStockSaleRefundApprovedBy")
  refundsRequested               Refund[]                @relation("RefundRequestedBy")
  refundsApproved                Refund[]                @relation("RefundApprovedBy")
  commissionSnapshotsLeadOwner   CommissionSnapshot[]    @relation("CommissionSnapshotLeadOwner")
  commissionSnapshotsSaleCreator CommissionSnapshot[]    @relation("CommissionSnapshotSaleCreator")
  commissionsRecipient           Commission[]            @relation("CommissionRecipient")
  commissionsCreatedBy           Commission[]            @relation("CommissionCreatedBy")
  walletTransactionsCreatedBy    WalletTransaction[]     @relation("WalletTxnCreatedBy")
  auditLogs                      AuditLog[]              @relation("AuditLogActor")
  notifications                  Notification[]          @relation("NotificationUser")
  branchQuarterTargetsCreated    BranchQuarterTarget[]   @relation("BranchQuarterTargetCreatedBy")

  @@index([branchId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[] @relation("RolePermissionRole")
  userRoles       UserRole[]       @relation("UserRoleRole")
  commissionRules CommissionRule[] @relation("CommissionRuleRole")

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[] @relation("RolePermissionPermission")

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation("RolePermissionRole", fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation("RolePermissionPermission", fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  branchId   String?
  createdAt  DateTime @default(now())
  assignedBy String?

  user   User    @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation("UserRoleRole", fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation("UserRoleBranch", fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([roleId, branchId])
  @@index([branchId])
  @@map("user_roles")
}

model Customer {
  id              String    @id @default(cuid())
  code            String    @unique
  fullName        String
  phone           String?   @unique
  email           String?   @unique
  birthDate       DateTime?
  notes           String?
  currentBranchId String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  currentBranch    Branch?                @relation("CustomerCurrentBranch", fields: [currentBranchId], references: [id], onDelete: SetNull)
  leads            Lead[]                 @relation("LeadCustomer")
  salesOrders      SalesOrder[]           @relation("SalesOrderCustomer")
  appointments     Appointment[]          @relation("AppointmentCustomer")
  serviceEvents    CustomerServiceEvent[] @relation("ServiceEventCustomer")
  wallets          Wallet[]               @relation("WalletCustomer")
  refunds          Refund[]               @relation("RefundCustomer")
  branchStockSales BranchStockSale[]      @relation("BranchStockSaleCustomer")
  entitlements     TreatmentEntitlement[] @relation("TreatmentEntitlementCustomer")

  @@index([currentBranchId])
  @@index([fullName])
  @@index([phone])
  @@map("customers")
}

model Lead {
  id                 String     @id @default(cuid())
  code               String     @unique
  branchId           String
  customerId         String?
  name               String
  phone              String?
  source             String?
  status             LeadStatus @default(NEW)
  currentOwnerUserId String?
  createdByUserId    String
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  branch              Branch               @relation("LeadBranch", fields: [branchId], references: [id], onDelete: Restrict)
  customer            Customer?            @relation("LeadCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  currentOwner        User?                @relation("LeadCurrentOwner", fields: [currentOwnerUserId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  ownerLogs           LeadOwnerLog[]       @relation("LeadOwnerLogLead")
  salesOrders         SalesOrder[]         @relation("SalesOrderLead")
  commissionSnapshots CommissionSnapshot[] @relation("CommissionSnapshotLead")

  @@index([branchId, status, createdAt])
  @@index([currentOwnerUserId, updatedAt])
  @@index([createdByUserId, createdAt])
  @@index([customerId])
  @@map("leads")
}

model LeadOwnerLog {
  id               String    @id @default(cuid())
  leadId           String
  assignedToUserId String
  assignedByUserId String
  assignedAt       DateTime  @default(now())
  endedAt          DateTime?
  reason           String?

  lead           Lead @relation("LeadOwnerLogLead", fields: [leadId], references: [id], onDelete: Cascade)
  assignedToUser User @relation("LeadOwnerAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  assignedByUser User @relation("LeadOwnerAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([leadId, assignedAt])
  @@index([assignedToUserId, assignedAt])
  @@index([leadId, endedAt])
  @@map("lead_owner_logs")
}

model Service {
  id                  String            @id @default(cuid())
  code                String            @unique
  name                String
  description         String?
  basePrice           Decimal?          @db.Decimal(18, 2)
  /// Commission group this service belongs to. Nullable so legacy services
  /// without a group still validate; tier-based commission lookup falls
  /// through to "no commission" when this is null.
  commissionGroupCode ServiceGroupCode?
  /// True for session-based programs (e.g. "Hair Growth Program — 7 sessions").
  /// When `true`, paying the parent SalesOrder mints a TreatmentEntitlement
  /// the customer can later draw down via appointments.
  isProgram           Boolean           @default(false)
  /// Sessions granted per unit when isProgram=true. Multiplied by item.quantity
  /// at entitlement-creation time. Required (validated in service code) when
  /// isProgram=true; otherwise should be null.
  defaultSessions     Int?
  isActive            Boolean           @default(true)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  salesOrderItems SalesOrderItem[]       @relation("SalesOrderItemService")
  appointments    Appointment[]          @relation("AppointmentService")
  serviceEvents   CustomerServiceEvent[] @relation("ServiceEventService")
  stockUsages     ServiceStockUsage[]    @relation("ServiceStockUsageService")
  entitlements    TreatmentEntitlement[] @relation("TreatmentEntitlementService")

  @@index([name])
  @@index([commissionGroupCode])
  @@map("services")
}

model SalesOrder {
  id                 String           @id @default(cuid())
  orderNo            String           @unique
  branchId           String
  customerId         String
  leadId             String?
  createdByUserId    String
  status             SalesOrderStatus @default(DRAFT)
  currency           String           @default("THB")
  subtotalAmount     Decimal          @default(0) @db.Decimal(18, 2)
  discountAmount     Decimal          @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal          @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal          @default(0) @db.Decimal(18, 2)
  depositRequired    Decimal          @default(0) @db.Decimal(18, 2)
  depositSatisfiedAt DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  branch              Branch                 @relation("SalesOrderBranch", fields: [branchId], references: [id], onDelete: Restrict)
  customer            Customer               @relation("SalesOrderCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  lead                Lead?                  @relation("SalesOrderLead", fields: [leadId], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items               SalesOrderItem[]       @relation("SalesOrderItemOrder")
  payments            Payment[]              @relation("PaymentSalesOrder")
  appointments        Appointment[]          @relation("AppointmentSalesOrder")
  commissionSnapshots CommissionSnapshot[]   @relation("CommissionSnapshotSalesOrder")
  commissions         Commission[]           @relation("CommissionSalesOrder")
  refunds             Refund[]               @relation("RefundSalesOrder")
  serviceEvents       CustomerServiceEvent[] @relation("ServiceEventSalesOrder")

  @@index([branchId, status, createdAt])
  @@index([leadId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([depositSatisfiedAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                  String   @id @default(cuid())
  salesOrderId        String
  serviceId           String
  quantity            Int      @default(1)
  unitPrice           Decimal  @db.Decimal(18, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(18, 2)
  netAmount           Decimal  @db.Decimal(18, 2)
  snapshotServiceCode String
  snapshotServiceName String
  snapshotUnitPrice   Decimal  @db.Decimal(18, 2)
  createdAt           DateTime @default(now())

  salesOrder           SalesOrder            @relation("SalesOrderItemOrder", fields: [salesOrderId], references: [id], onDelete: Cascade)
  service              Service               @relation("SalesOrderItemService", fields: [serviceId], references: [id], onDelete: Restrict)
  /// 1:1 — when the item's service is a program, paying the parent order
  /// mints exactly one entitlement for this line. Enforced by the
  /// `salesOrderItemId @unique` on TreatmentEntitlement.
  treatmentEntitlement TreatmentEntitlement? @relation("TreatmentEntitlementSalesOrderItem")

  @@index([salesOrderId])
  @@index([serviceId])
  @@map("sales_order_items")
}

model Payment {
  id              String        @id @default(cuid())
  salesOrderId    String
  amount          Decimal       @db.Decimal(18, 2)
  paymentMethod   PaymentMethod
  paymentType     PaymentType
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdByUserId String
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  salesOrder SalesOrder @relation("PaymentSalesOrder", fields: [salesOrderId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([salesOrderId, paymentType, status])
  @@index([paidAt])
  @@index([createdByUserId, createdAt])
  @@map("payments")
}

model Appointment {
  id                     String            @id @default(cuid())
  appointmentNo          String            @unique
  branchId               String
  salesOrderId           String
  customerId             String
  serviceId              String
  doctorUserId           String?
  createdByUserId        String
  status                 AppointmentStatus @default(BOOKED)
  scheduledAt            DateTime
  checkedInAt            DateTime?
  completedAt            DateTime?
  notes                  String?
  /// Optional — set when the visit is redeemed against a treatment
  /// program. Validated at booking time (must match customer + service,
  /// must have remaining sessions, must not be expired).
  entitlementId          String?
  /// Stamped exactly once when this appointment's session has been
  /// drawn down from the entitlement. Acts as the idempotency key for
  /// both `complete()` (auto-consume) and the explicit
  /// `POST /appointments/:id/consume` endpoint.
  entitlementConsumedAt  DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  branch        Branch                 @relation("AppointmentBranch", fields: [branchId], references: [id], onDelete: Restrict)
  salesOrder    SalesOrder             @relation("AppointmentSalesOrder", fields: [salesOrderId], references: [id], onDelete: Cascade)
  customer      Customer               @relation("AppointmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  service       Service                @relation("AppointmentService", fields: [serviceId], references: [id], onDelete: Restrict)
  doctor        User?                  @relation("AppointmentDoctor", fields: [doctorUserId], references: [id], onDelete: SetNull)
  createdBy     User                   @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  entitlement   TreatmentEntitlement?  @relation("TreatmentEntitlementAppointment", fields: [entitlementId], references: [id], onDelete: SetNull)
  serviceEvents CustomerServiceEvent[] @relation("ServiceEventAppointment")

  @@index([branchId, scheduledAt])
  @@index([salesOrderId, status])
  @@index([customerId, scheduledAt])
  @@index([doctorUserId, scheduledAt])
  @@index([entitlementId])
  @@map("appointments")
}

/// Session-based program entitlement minted when a SalesOrder containing a
/// program-line transitions to status=PAID. One row per SalesOrderItem
/// (`salesOrderItemId @unique` enforces 1:1).
///
/// Drawdown: each `Appointment` linked via `entitlementId` may consume one
/// session, idempotently stamped on `Appointment.entitlementConsumedAt`.
/// Over-consumption is prevented atomically by a Postgres-side guard
/// (`UPDATE ... WHERE consumed_sessions < total_sessions`).
model TreatmentEntitlement {
  id               String    @id @default(cuid())
  customerId       String
  salesOrderItemId String    @unique
  serviceId        String
  totalSessions    Int
  consumedSessions Int       @default(0)
  activatedAt      DateTime  @default(now())
  expiredAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer       Customer       @relation("TreatmentEntitlementCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  service        Service        @relation("TreatmentEntitlementService", fields: [serviceId], references: [id], onDelete: Restrict)
  salesOrderItem SalesOrderItem @relation("TreatmentEntitlementSalesOrderItem", fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  appointments   Appointment[]  @relation("TreatmentEntitlementAppointment")

  @@index([customerId])
  @@index([serviceId])
  @@index([customerId, serviceId, expiredAt])
  @@map("treatment_entitlements")
}

/// A row in this table is a single tier in a commission ladder. A "ladder"
/// is identified by `(branchId, serviceGroupCode)` and consists of all
/// rows in that pair sharing the same `commissionType`. Tier selection at
/// pay-out time picks the row with the largest `minAmount <= orderAmount`.
///
/// Legacy fields (`roleId`, `serviceId`, `maxAmount`, `startsAt`, `endsAt`)
/// remain for backward compat with non-tiered, role-scoped rules — bulk
/// upsert via the API only writes tier rows and ignores them.
/// A row in the commission ladder. Always tied to a (branch, serviceGroupCode)
/// pair plus a `minAmount` threshold; the engine picks the highest-minimum
/// row whose threshold ≤ the order's group subtotal.
///
/// Service-specific rules (legacy `serviceId`) were removed in migration
/// `20260508_drop_commission_rule_service_id`. All commission selection now
/// flows through `service.commissionGroupCode` → `commissionRule.serviceGroupCode`.
model CommissionRule {
  id               String              @id @default(cuid())
  roleId           String?
  commissionType   CommissionType
  valueType        CommissionValueType
  value            Decimal             @db.Decimal(18, 4)
  branchId         String?
  serviceGroupCode ServiceGroupCode?
  minAmount        Decimal?            @db.Decimal(18, 2)
  maxAmount        Decimal?            @db.Decimal(18, 2)
  startsAt         DateTime            @default(now())
  endsAt           DateTime?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  role      Role?                @relation("CommissionRuleRole", fields: [roleId], references: [id], onDelete: SetNull)
  branch    Branch?              @relation("CommissionRuleBranch", fields: [branchId], references: [id], onDelete: SetNull)
  snapshots CommissionSnapshot[] @relation("CommissionSnapshotRule")

  @@index([roleId, commissionType, startsAt, endsAt])
  @@index([branchId, serviceGroupCode, isActive, minAmount])
  @@map("commission_rules")
}

model CommissionSnapshot {
  id                           String              @id @default(cuid())
  salesOrderId                 String
  leadId                       String?
  commissionRuleId             String?
  leadOwnerUserId              String?
  saleCreatorUserId            String
  commissionType               CommissionType
  serviceGroupCode             ServiceGroupCode?
  ruleValueType                CommissionValueType
  ruleValue                    Decimal             @db.Decimal(18, 4)
  groupSubtotal                Decimal?            @db.Decimal(18, 2)
  computedAmount               Decimal             @db.Decimal(18, 2)
  eligibilityDepositPaid       Boolean
  eligibilityAppointmentBooked Boolean
  eligibleAt                   DateTime?
  lockedAt                     DateTime?
  lockReason                   String?
  snapshotLeadOwnerName        String?
  snapshotSaleCreatorName      String
  snapshotRoleCode             RoleCode?
  snapshotServiceName          String?
  snapshotBranchName           String?
  createdAt                    DateTime            @default(now())

  salesOrder      SalesOrder      @relation("CommissionSnapshotSalesOrder", fields: [salesOrderId], references: [id], onDelete: Cascade)
  lead            Lead?           @relation("CommissionSnapshotLead", fields: [leadId], references: [id], onDelete: SetNull)
  commissionRule  CommissionRule? @relation("CommissionSnapshotRule", fields: [commissionRuleId], references: [id], onDelete: SetNull)
  leadOwnerUser   User?           @relation("CommissionSnapshotLeadOwner", fields: [leadOwnerUserId], references: [id], onDelete: SetNull)
  saleCreatorUser User            @relation("CommissionSnapshotSaleCreator", fields: [saleCreatorUserId], references: [id], onDelete: Restrict)
  commissions     Commission[]    @relation("CommissionSnapshot")

  @@index([salesOrderId, commissionType])
  @@index([salesOrderId, serviceGroupCode, commissionType])
  @@index([leadOwnerUserId, eligibleAt])
  @@index([saleCreatorUserId, eligibleAt])
  @@index([lockedAt])
  @@map("commission_snapshots")
}

model Commission {
  id                String           @id @default(cuid())
  snapshotId        String
  salesOrderId      String
  recipientUserId   String
  createdByUserId   String?
  type              CommissionType
  status            CommissionStatus @default(PENDING)
  amount            Decimal          @db.Decimal(18, 2)
  currency          String           @default("THB")
  eligibleAt        DateTime?
  lockedAt          DateTime?
  paidAt            DateTime?
  revokedAt         DateTime?
  revokedByRefundId String?
  revokedReason     String?
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  snapshot        CommissionSnapshot @relation("CommissionSnapshot", fields: [snapshotId], references: [id], onDelete: Cascade)
