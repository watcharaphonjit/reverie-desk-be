/// Quarterly revenue target for a single branch. Owned by the branch
/// management roles (BRANCH_MANAGER for own branch, SUPER_BRANCH_MANAGER
/// + ADMIN for any branch). The `totalTarget` MUST equal the sum of its
/// `categories[*].targetAmount` — enforced at the service layer (Prisma
/// can't express that constraint declaratively).
///
/// Progress is computed on-demand by `TargetProgressService` and is
/// never persisted: actuals come from `SalesOrder.status = COMPLETED &&
/// completedAt ∈ quarter` rolled up by `service.commissionGroupCode`.
model BranchQuarterTarget {
  id              String   @id @default(cuid())
  branchId        String
  /// Calendar year (e.g. 2026). Validated `>= 2020 && <= 2100` at the DTO layer.
  year            Int
  /// Quarter number 1..4. Validated at the DTO layer.
  quarter         Int
  totalTarget     Decimal  @db.Decimal(18, 2)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch     Branch                        @relation("BranchQuarterTargetBranch", fields: [branchId], references: [id], onDelete: Cascade)
  createdBy  User                          @relation("BranchQuarterTargetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  categories BranchQuarterTargetCategory[] @relation("BranchQuarterTargetCategoryParent")

  @@unique([branchId, year, quarter])
  @@index([branchId, year])
  @@map("branch_quarter_targets")
}

/// One row per (target, commissionGroup). Sum of `targetAmount` across
/// all rows for a given target MUST equal the parent's `totalTarget`
/// (validated in `TargetsService`). Cascade-deletes with the parent so
/// recreating a target doesn't leak orphan rows.
model BranchQuarterTargetCategory {
  id              String           @id @default(cuid())
  targetId        String
  /// Re-uses the existing `ServiceGroupCode` enum so the same six groups
  /// are referenced by `Service.commissionGroupCode`,
  /// `CommissionRule.serviceGroupCode`, and target categories. Avoids a
  /// parallel-enum drift problem.
  commissionGroup ServiceGroupCode
  targetAmount    Decimal          @db.Decimal(18, 2)

  target BranchQuarterTarget @relation("BranchQuarterTargetCategoryParent", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, commissionGroup])
  @@index([commissionGroup])
  @@map("branch_quarter_target_categories")
}
