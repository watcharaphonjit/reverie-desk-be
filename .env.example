# Reverie Desk API – environment template.
# Copy to `.env` and fill values. Joi validates every variable at boot;
# missing or malformed values fail-fast before the HTTP listener binds.

# ─── runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── database (required) ─────────────────────────────────
DATABASE_URL=postgresql://reverie:reverie@localhost:5432/reverie_desk

# ─── auth (required) ─────────────────────────────────────
# JWT_SECRET must be at least 16 characters; rotate on incident.
JWT_SECRET=please-change-me-to-a-real-32-byte-random-string
JWT_EXPIRES_IN=12h

# ─── redis (optional in dev, required in prod) ───────────
# When REDIS_HOST is unset:
#   - cache runs in-process (NOT shared between API and workers)
#   - queues run in no-op mode (jobs are dropped with a debug log)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ─── caching ─────────────────────────────────────────────
CACHE_TTL_SECONDS=60
CACHE_DASHBOARD_TTL_SECONDS=30
CACHE_REPORT_TTL_SECONDS=300

# ─── rate limiting ───────────────────────────────────────
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_AUTH_LIMIT=5
THROTTLE_ADMIN_LIMIT=50
THROTTLE_TTL_MS=60000
# Set to "true" only in CI / smoke runs. Production must be "false".
THROTTLE_DISABLED=false

# ─── automation tunables ─────────────────────────────────
LOW_STOCK_THRESHOLD=5
EXPIRY_ALERT_DAYS=30
LEAD_FOLLOWUP_HOURS=48
APPOINTMENT_REMINDER_WINDOW_HOURS=24
WALLET_EXPIRY_NOTICE_DAYS=7
# Comma-separated rule codes to disable at boot.
AUTOMATION_DISABLED=

# ─── feature flags ───────────────────────────────────────
ENABLE_QUEUES=true
ENABLE_REQUEST_LOGGING=true
# Comma-separated origins or "*" for any.
CORS_ORIGINS=*

# ─── prisma ──────────────────────────────────────────────
PRISMA_LOG_QUERIES=false
PRISMA_SLOW_QUERY_MS=250

# ─── workers ─────────────────────────────────────────────
# Set WORKER_MODE=embedded to run BullMQ workers in the API process
# (small deploys / dev). Production should leave this unset and run
# `npm run worker` in a dedicated container instead.
WORKER_MODE=
NOTIFICATION_WORKER_CONCURRENCY=5
AUTOMATION_WORKER_CONCURRENCY=2
REPORTING_WORKER_CONCURRENCY=2
